{
  "name": "drawback-engine",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm build && pnpm -r --if-present typecheck",
    "lint": "eslint . --max-warnings 0",
    "test": "pnpm build && vitest run",
    "test:rules": "pnpm build && vitest run packages/drawback-engine packages/chess-core",
    "test:search": "pnpm build && vitest run packages/probe-search packages/drawback-search packages/chess-evaluator",
    "test:arena": "pnpm build && vitest run packages/simulation-arena apps/engine-cli",
    "catalog:import-observed": "node scripts/import-observed-catalog.mjs",
    "catalog:verify-evidence": "node scripts/validate-rule-verification-evidence.mjs",
    "benchmark:posterior": "pnpm build && node scripts/benchmark-posterior-aggregation.mjs",
    "benchmark:posterior:combine": "node scripts/combine-posterior-benchmark-shards.mjs",
    "arena:strength": "pnpm --filter @drawbackengine/cli player-private:strength --",
    "play:web": "pnpm --filter @drawbackengine/play-web... build && pnpm --filter @drawbackengine/play-web start --",
    "check:boundaries": "node scripts/check-repository-boundaries.mjs",
    "smoke:packages": "node scripts/smoke-built-packages.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm catalog:verify-evidence && pnpm check:boundaries && vitest run && pnpm smoke:packages"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^24.1.0",
    "eslint": "^9.32.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  }
}
