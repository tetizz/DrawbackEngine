{
  "name": "@drawbackengine/chess-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prebuild": "node ../../scripts/clean-owned-build-output.mjs",
    "build": "tsc -p tsconfig.build.json",
    "postbuild": "node ../../scripts/normalize-built-artifacts.mjs --package",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@drawbackengine/drawback-engine": "workspace:*",
    "@drawbackengine/shared": "workspace:*",
    "chess.js": "^1.4.0",
    "chessops": "0.15.1"
  }
}
