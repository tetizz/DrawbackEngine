{
  "name": "@drawbackengine/play-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prebuild": "node ../../scripts/clean-owned-build-output.mjs",
    "build": "tsc -p tsconfig.server.json && vite build",
    "postbuild": "node ../../scripts/normalize-built-artifacts.mjs --package",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "start": "node dist/server/server/entry.js"
  },
  "dependencies": {
    "@drawbackengine/chess-core": "workspace:*",
    "@drawbackengine/chess-evaluator": "workspace:*",
    "@drawbackengine/drawback-engine": "workspace:*",
    "@drawbackengine/drawback-search": "workspace:*",
    "@drawbackengine/shared": "workspace:*",
    "@drawbackengine/simulation-arena": "workspace:*",
    "react": "^19.0.0",
    "react-chessboard": "5.10.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^26.0.0",
    "vite": "^6.0.0"
  }
}
